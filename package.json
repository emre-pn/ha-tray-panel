{
  "name": "ev-paneli",
  "productName": "Ev Paneli",
  "version": "1.7.1",
  "description": "Windows tray app and quick control panel for Home Assistant",
  "main": "src/main.js",
  "author": "Emre Sav",
  "license": "MIT",
  "homepage": "https://github.com/emre-pn/ha-tray-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emre-pn/ha-tray-panel.git"
  },
  "bugs": {
    "url": "https://github.com/emre-pn/ha-tray-panel/issues"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:tasinabilir": "electron-builder --win portable --x64 --publish never",
    "ikon": "node araclar/ikon-uret.js",
    "test": "node --test",
    "kontrol": "node araclar/kontrol.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
